{
  "name": "@urth/three-html-panel",
  "version": "0.2.0",
  "description": "Show existing web pages, scripts included and from any origin, as interactive panels in a three.js scene",
  "keywords": [
    "html",
    "iframe",
    "panel",
    "three",
    "three.js",
    "ui",
    "vr",
    "webxr"
  ],
  "homepage": "https://github.com/urth-inc/three-html-panel#readme",
  "bugs": {
    "url": "https://github.com/urth-inc/three-html-panel/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urth-inc/three-html-panel.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": [
    "./lib/agent-script.js"
  ],
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./page": {
      "types": "./lib/page.d.ts",
      "default": "./lib/page.js"
    },
    "./agent-script.js": "./lib/agent-script.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "dev:all": "pnpm --parallel -r --include-workspace-root dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "e2e": "playwright test",
    "pack:lib": "vp pack",
    "prepublishOnly": "vp check && vp test run && vp pack",
    "dev:sites": "pnpm --parallel --filter \"./examples/sites/*\" dev",
    "build:sites": "pnpm --filter \"./examples/sites/*\" build",
    "build:deploy": "vp build --mode deploy && pnpm --filter \"./examples/sites/*\" run build --mode deploy",
    "typecheck:sites": "pnpm --filter \"./examples/sites/*\" --if-present typecheck",
    "dev:live-demo": "VITE_HOST_ORIGIN=http://localhost:5179 pnpm --parallel --filter \"./examples/sites/*\" --filter ./examples/live-demo dev",
    "build:live-demo": "pnpm --filter ./examples/live-demo build",
    "typecheck:live-demo": "pnpm --filter ./examples/live-demo typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "jsdom": "30.1.2",
    "publint": "0.3.25",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "three": ">=0.158.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.23.0"
}
