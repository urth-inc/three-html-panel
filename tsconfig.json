{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "examples",
    "e2e",
    "vite.config.ts",
    "vite.panels.config.ts",
    "playwright.config.ts"
  ],
  // The example sites check their own code (their own tsconfig), and the live
  // demo all of it: its Vite config uses its own vite, not the root's.
  "exclude": ["examples/sites/*/src", "examples/live-demo"]
}
